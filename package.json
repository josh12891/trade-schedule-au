{
  "name": "trade-schedule-au",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Trade Schedule — Australian Dynamics job board for tradies. Offline, no account.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-privacy-docs.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "assets": "node scripts/generate-brand-assets.mjs && capacitor-assets generate --iconBackgroundColor '#0B1F33' --iconBackgroundColorDark '#0B1F33' --splashBackgroundColor '#0B1F33' --splashBackgroundColorDark '#0B1F33' && cp scripts/favicon.svg public/favicon.svg",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "android:keystore": "bash scripts/generate-upload-keystore.sh",
    "android:bundle": "bash scripts/android-bundle-release.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "oxlint": "^1.24.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
